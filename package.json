{
  "name": "movie-standings",
  "version": "0.2.0",
  "description": "Movies from the past year, recommended and ranked nightly by our AI editor.",
  "type": "module",
  "private": true,
  "homepage": "https://movies.mickschroeder.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mick-schroeder/movies.mickschroeder.com.git"
  },
  "bugs": {
    "url": "https://github.com/mick-schroeder/movies.mickschroeder.com/issues"
  },
  "license": "MIT",
  "author": "Mick Schroeder, LLC",
  "contributors": [
    "Steven Lu (original author, https://github.com/sjlu/popular-movies)"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:data": "node --env-file-if-exists=.env pipeline/build.ts",
    "sync:lists": "node --env-file-if-exists=.env pipeline/sync-lists.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "node --env-file-if-exists=.env --test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@astrojs/react": "^7",
    "@astrojs/sitemap": "^3.7.6",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4",
    "astro": "^7.4.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3": "^7.9.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "16.38.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@types/d3": "^7.4.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-astro": "^3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8"
  }
}
