---
import BrandIcon from "@/components/brand-icon.astro"
import { Badge } from "@/components/ui/badge"
import MovieJoyplot from "@/components/movie-joyplot.astro"
import { SITE } from "@/consts"
import Layout from "@/layouts/base.astro"
import { movieLinks, moviePath } from "@/lib/links"
import { getMovies, getStandings, type MovieSummary } from "@/lib/movies"
import { formatDate } from "@/lib/ridgeline"
import { ArrowLeft, ArrowRight } from "lucide-react"
import { genreLabel } from "@/lib/utils"
import {
  type SimpleIcon,
  siImdb,
  siLetterboxd,
  siMdblist,
  siMetacritic,
  siRottentomatoes,
  siThemoviedatabase,
  siTrakt,
  siYoutube,
} from "simple-icons"

export async function getStaticPaths() {
  return (await getMovies()).map((movie) => ({
    params: { slug: moviePath(movie).split("/")[2]! },
    props: { movie },
  }))
}

const { movie } = Astro.props as { movie: MovieSummary }
const links = movieLinks(movie)

// Its neighbours in the current standings
const standings = await getStandings()
const neighbour = (rank: number) => {
  const item = standings[rank - 1]
  return (
    item && {
      rank,
      title: item.title,
      href: moviePath({ id: item.tmdb_id, title: item.title }),
    }
  )
}
const prev = movie.current && neighbour(movie.current - 1)
const next = movie.current && neighbour(movie.current + 1)

// Each service's logo
const ICONS: Record<string, SimpleIcon> = {
  Trailer: siYoutube,
  TMDB: siThemoviedatabase,
  IMDb: siImdb,
  Letterboxd: siLetterboxd,
  MDBList: siMdblist,
  "Rotten Tomatoes": siRottentomatoes,
  Metacritic: siMetacritic,
  Trakt: siTrakt,
}

const releaseYear = movie.release_date?.slice(0, 4)
const released = movie.release_date && formatDate(movie.release_date)
const genres = movie.genres.map((genre) => genreLabel([genre], 1))
// "2h 53m"
const hours = Math.floor((movie.runtime ?? 0) / 60)
const minutes = (movie.runtime ?? 0) % 60
const runtime = [hours && `${hours}h`, minutes && `${minutes}m`]
  .filter(Boolean)
  .join(" ")

// One fact per line under the title, App Store style
const details = [
  [released && `Released ${released}`, runtime].filter(Boolean).join(" · "),
].filter(Boolean)

const jsonLd = [
  {
    "@type": "Movie",
    name: movie.title,
    ...(movie.release_date && { datePublished: movie.release_date }),
    ...(movie.poster_url && { image: movie.poster_url }),
    sameAs: links
      .filter((link) => link.name !== "Trailer")
      .map((link) => link.url),
  },
]
---

<Layout
  title={`${movie.title}${releaseYear ? ` (${releaseYear})` : ""} · ${SITE.title}`}
  description={`How ${movie.title}${releaseYear ? ` (${releaseYear})` : ""} ranked among the best movies of the year, day by day.`}
  jsonLd={jsonLd}
>
  {(movie.backdrop_url ?? movie.poster_url) && (
    <img src={movie.backdrop_url ?? movie.poster_url} alt="" class="backdrop" />
  )}
  <section class="flex flex-1 flex-col overflow-hidden">
    <div class="flex items-start gap-4 px-4 pt-6 sm:gap-6 sm:px-6 sm:pt-10">
      {movie.poster_url && (
        <img
          src={movie.poster_url}
          alt=""
          width="500"
          height="750"
          class="w-20 shrink-0 rounded-sm sm:w-36"
        />
      )}
      <div>
        <h1 class="font-heading text-[clamp(2.25rem,8vw,6rem)] leading-[0.88] font-extrabold tracking-[-0.055em] text-balance">
          {movie.title}
        </h1>
        <div class="mt-3 text-muted-foreground sm:mt-4 sm:text-lg">
          {details.map((line) => (
            <p>{line}</p>
          ))}
        </div>
        {genres.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Genres">
            {genres.map((genre) => (
              <li>
                <Badge
                  variant="outline"
                  className="h-6 rounded-full border-foreground/25 px-2.5 text-sm"
                >
                  {genre}
                </Badge>
              </li>
            ))}
          </ul>
        )}
        <nav aria-label="Find it elsewhere" class="mt-4">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground">
            {links.map(({ name, url }) => (
              <li>
                <a
                  href={url}
                  class="flex items-center gap-1.5 hover:text-foreground"
                >
                  {ICONS[name] && <BrandIcon icon={ICONS[name]} />}
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    {/* The ridges take whatever height is left */}
    <div class="flex flex-1 flex-col">
      {movie.years.map((year) => (
        <MovieJoyplot movie={movie} year={year} />
      ))}
    </div>

    {(prev || next) && (
      <nav
        aria-label="Current standings"
        class="grid grid-cols-2 gap-6 px-4 pt-2 pb-6 sm:px-6"
      >
        {prev ? (
          <a href={prev.href} class="group flex items-center gap-3">
            <span class="flex shrink-0 items-center font-heading text-4xl leading-none font-extrabold tracking-[-0.05em] text-muted-foreground tabular-nums group-hover:text-foreground">
              <ArrowLeft
                aria-hidden="true"
                className="size-8 shrink-0 stroke-[2.5]"
              />
              <span class="sr-only">Previous: </span>#{prev.rank}
            </span>
            <span class="font-medium text-balance group-hover:text-primary">
              {prev.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={next.href}
            class="group flex items-center justify-end gap-3 text-right"
          >
            <span class="font-medium text-balance group-hover:text-primary">
              {next.title}
            </span>
            <span class="flex shrink-0 items-center font-heading text-4xl leading-none font-extrabold tracking-[-0.05em] text-muted-foreground tabular-nums group-hover:text-foreground">
              <span class="sr-only">Next: </span>#{next.rank}
              <ArrowRight
                aria-hidden="true"
                className="size-8 shrink-0 stroke-[2.5]"
              />
            </span>
          </a>
        )}
      </nav>
    )}
  </section>
</Layout>
