---
import { LIST_SIZE, SITE } from "@/consts"
import Standings from "@/layouts/standings.astro"
import { getStandings } from "@/lib/movies"

const movies = await getStandings()

const jsonLd = [
  {
    "@type": "ItemList",
    name: "Tonight's movie standings",
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    itemListElement: movies.map((movie, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Movie",
        name: movie.title,
        sameAs: `https://www.imdb.com/title/${movie.imdb_id}/`,
        ...(movie.poster_url && { image: movie.poster_url }),
      },
    })),
  },
]
---

<Standings
  title={`Tonight’s ${LIST_SIZE} · ${SITE.title}`}
  description={SITE.description}
  jsonLd={jsonLd}
  view="posters"
/>
