---
// Served by S3 (the bucket's ErrorDocument) for any page that doesn't exist
import { SITE } from "@/consts"
import Layout from "@/layouts/base.astro"
---

<Layout title={`Not found · ${SITE.title}`} description="There's no page here.">
  <div class="mx-auto flex max-w-3xl flex-col gap-4 px-4 pt-14">
    <h1 class="font-heading text-[clamp(2.5rem,8vw,4.5rem)] leading-[0.88] font-extrabold tracking-[-0.05em]">
      Not found
    </h1>
    <p class="text-muted-foreground">
      There’s no page here.
      <a href="/" class="underline hover:text-foreground">
        See the best movies of the past year
      </a>
    </p>
  </div>
</Layout>
