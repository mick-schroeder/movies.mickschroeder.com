---
interface Props {
  /** The site's name, linked home. */
  name: string
  /** Leave the name out, when the page shows it large itself. */
  hideTitle?: boolean
}
const { name, hideTitle = false } = Astro.props
---

<header class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
  <a
    href="/"
    class:list={[
      "font-heading text-lg font-bold tracking-tight",
      hideTitle && "invisible",
    ]}
  >
    {name}
  </a>
  <!-- The site's own links, at the right -->
  <slot />
</header>
